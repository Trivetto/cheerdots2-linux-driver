#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    case "$1" in
        remove|deconfigure)
            systemctl disable --now cheerdots.service >/dev/null 2>&1 || true ;;
        upgrade)
            systemctl stop cheerdots.service >/dev/null 2>&1 || true ;;
    esac
fi
pkill -f "m cheerdots\.gui" >/dev/null 2>&1 || true
exit 0
