#!/usr/bin/env bash
# Sterowanie sterownikiem CheerDots 2 (wersja dla systemowego Bluetooth)
SOCK=/run/cheerdots/cheerdots.sock
send() { python3 -c "import socket,sys;s=socket.socket(socket.AF_UNIX);s.settimeout(60);s.connect('$SOCK');s.sendall(sys.argv[1].encode()+b'\n');print(s.makefile().readline().strip())" "$1"; }
case "${1:-status}" in
  on)      sudo systemctl enable --now cheerdots.service ;;
  off)     sudo systemctl disable --now cheerdots.service
           echo "Sterownik wyłączony (myszka działa dalej jako zwykła mysz, bez gestów)." ;;
  restart) sudo systemctl restart cheerdots.service ;;
  setup)   sudo /usr/lib/cheerdots/bluez-mtu set
           echo "Jeśli myszka była sparowana wcześniej: usuń ją w Ustawieniach -> Bluetooth i sparuj ponownie." ;;
  pair)    send '{"cmd":"forget_device"}' >/dev/null
           echo "Usunięto parowanie myszki. Włącz w niej tryb parowania i sparuj ją w Ustawieniach -> Bluetooth"
           echo "(albo w oknie: cheerdots-ctl gui -> Wybierz urządzenie -> Szukaj nowych)."
           (systemsettings kcm_bluetooth >/dev/null 2>&1 &) ;;
  log)     journalctl -u cheerdots.service -f -n 50 ;;
  info)    send '{"cmd":"status"}' ;;
  status)  systemctl status cheerdots.service --no-pager -n 10; echo
           /usr/lib/cheerdots/bluez-mtu status; echo; send '{"cmd":"status"}' 2>/dev/null ;;
  gui)     cheerdots-gui --show >/dev/null 2>&1 & ;;
  debug)   case "${2:-on}" in
             on)  echo 'CHEERDOTS_ARGS=--raw-log' | sudo tee /etc/default/cheerdots >/dev/null
                  echo "Podgląd surowych klawiszy z myszki włączony (cheerdots-ctl log)." ;;
             off) echo 'CHEERDOTS_ARGS=' | sudo tee /etc/default/cheerdots >/dev/null
                  echo "Podgląd surowych klawiszy wyłączony." ;;
           esac
           sudo systemctl restart cheerdots.service ;;
  *)       echo "użycie: cheerdots-ctl on|off|restart|setup|pair|log|info|status|gui|debug on|off" ;;
esac
